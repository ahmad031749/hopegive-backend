{
  "name": "hopebridge-backend",
  "version": "1.0.0",
  "description": "HopeBridge Donation Backend — Express + TypeScript + PostgreSQL + Stripe",
  "main": "dist/server.js",
  "scripts": {
    "dev":     "ts-node-dev --respawn src/server.ts",
    "build":   "tsc",
    "start":   "node dist/server.js",
    "migrate": "ts-node src/db/migrate.ts",
    "seed":    "ts-node src/db/seed.ts",
    "test":    "jest"
  },
  "dependencies": {
    "express":            "^4.19.2",
    "pg":                 "^8.12.0",
    "stripe":             "^16.3.0",
    "bcrypt":             "^5.1.1",
    "jsonwebtoken":       "^9.0.2",
    "helmet":             "^7.1.0",
    "cors":               "^2.8.5",
    "express-rate-limit": "^7.4.0",
    "zod":                "^3.23.8",
    "dotenv":             "^16.4.5",
    "nodemailer":         "^6.9.14"
  },
  "devDependencies": {
    "typescript":         "^5.5.4",
    "ts-node":            "^10.9.2",
    "ts-node-dev":        "^2.0.0",
    "@types/express":     "^4.17.21",
    "@types/node":        "^22.5.0",
    "@types/pg":          "^8.11.6",
    "@types/bcrypt":      "^5.0.2",
    "@types/jsonwebtoken":"^9.0.6",
    "@types/cors":        "^2.8.17",
    "@types/nodemailer":  "^6.4.15",
    "jest":               "^29.7.0",
    "ts-jest":            "^29.2.4",
    "@types/jest":        "^29.5.12",
    "supertest":          "^7.0.0",
    "@types/supertest":   "^6.0.2"
  }
}
